{
  "version": 1,
  "name": "Built-in LaTeX snippets",
  "description": "Built-in LaTeX snippet library for Eukolia.",
  "namespace": "latex",
  "language": "latex",
  "snippets": [
    {
      "id": "item",
      "trigger": {
        "pattern": "item"
      },
      "description": "\\item on a newline",
      "expand": "auto",
      "body": "\n\\item "
    },
    {
      "id": "subscript",
      "trigger": {
        "pattern": "__"
      },
      "description": "subscript",
      "expand": "auto",
      "body": "_{${1:${VISUAL}}}"
    },
    {
      "id": "superscript",
      "trigger": {
        "pattern": "\\*\\*"
      },
      "description": "superscript",
      "expand": "auto",
      "body": "^{${1:${VISUAL}}}"
    },
    {
      "id": "dots",
      "trigger": {
        "pattern": "\\.\\.\\."
      },
      "description": "\\dots",
      "expand": "auto",
      "body": "\\dots"
    },
    {
      "id": "equation",
      "trigger": {
        "pattern": "BEQ"
      },
      "description": "equation environment",
      "expand": "auto",
      "body": [
        {
          "type": "text",
          "value": "\\begin{equation}\n\t"
        },
        {
          "type": "tabstop",
          "index": 1,
          "default": "${VISUAL}"
        },
        {
          "type": "text",
          "value": "\n\\end{equation}"
        },
        {
          "type": "tabstop",
          "index": 0
        }
      ]
    },
